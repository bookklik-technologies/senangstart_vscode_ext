{
  "name": "senangstart",
  "displayName": "SenangStart",
  "description": "Browse SenangStart sections, icons, shapes and patterns, with library setup and HTML snippets.",
  "publisher": "bookklik-technologies",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bookklik-technologies/senangstart_vscode_ext"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:html",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:php",
    "onLanguage:blade"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "SenangStart",
      "properties": {
        "senangstart.cssAutocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Suggest SenangStart CSS attributes and utility tokens in HTML, Vue, Svelte, PHP, and Blade files."
        }
      }
    },
    "snippets": [
      { "language": "html", "path": "./snippets/senangstart.json" },
      { "language": "vue", "path": "./snippets/senangstart.json" },
      { "language": "svelte", "path": "./snippets/senangstart.json" },
      { "language": "php", "path": "./snippets/senangstart.json" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "senangstart-sidebar",
          "title": "SenangStart",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "senangstart-sidebar": [
        {
          "type": "webview",
          "id": "senangstart-sections",
          "name": "SenangStart"
        }
      ]
    },
    "commands": [
      {
        "command": "senangstart.refreshSections",
        "category": "SenangStart",
        "title": "Refresh Sections",
        "icon": "$(refresh)"
      }
    ]
  },
  "dependencies": {
    "@bookklik/senangstart-icons": "1.0.17",
    "@bookklik/senangstart-shapes": "0.1.2"
  }
}
